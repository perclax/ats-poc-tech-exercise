{% extends 'base.html.twig' %}

{% block title %}Applications{% endblock %}

{% block scripts %}<script type="module" src="/scripts/application.js"></script>{% endblock %}

{% block body %}
    <h1>Applications</h1>
    <p>Showing up to 100 newest matching applications. Narrow your filters to find older applications.</p>
    <form method="get" action="{{ path('application_list') }}" class="filters">
        <div class="search-field">
            <label for="search">Candidate name or email</label>
            <input id="search" name="search" value="{{ parameters.values.search }}" maxlength="254"{% if parameters.errors.search is defined %} aria-invalid="true" aria-describedby="search-error"{% endif %}>
            {% if parameters.errors.search is defined %}<p id="search-error" class="field-error">{{ parameters.errors.search }}</p>{% endif %}
        </div>
        <div>
            <label for="job">Job</label>
            <select id="job" name="job"{% if parameters.errors.job is defined %} aria-invalid="true" aria-describedby="job-error"{% endif %}>
                <option value="">All jobs</option>
                {% for job in jobs %}<option value="{{ job.id }}"{% if parameters.values.job == job.id %} selected{% endif %}>{{ job.title }}</option>{% endfor %}
            </select>
            {% if parameters.errors.job is defined %}<p id="job-error" class="field-error">{{ parameters.errors.job }}</p>{% endif %}
        </div>
        <div>
            <label for="applicationStatus">Application status</label>
            <select id="applicationStatus" name="applicationStatus"{% if parameters.errors.applicationStatus is defined %} aria-invalid="true" aria-describedby="applicationStatus-error"{% endif %}>
                <option value="">All application statuses</option>
                <option value="received"{% if parameters.values.applicationStatus == 'received' %} selected{% endif %}>Received</option>
            </select>
            {% if parameters.errors.applicationStatus is defined %}<p id="applicationStatus-error" class="field-error">{{ parameters.errors.applicationStatus }}</p>{% endif %}
        </div>
        <div>
            <label for="enrichmentStatus">Analysis status</label>
            <select id="enrichmentStatus" name="enrichmentStatus"{% if parameters.errors.enrichmentStatus is defined %} aria-invalid="true" aria-describedby="enrichmentStatus-error"{% endif %}>
                <option value="">All analysis statuses</option>
                {% for value in ['pending', 'processing', 'completed', 'failed'] %}<option value="{{ value }}"{% if parameters.values.enrichmentStatus == value %} selected{% endif %}>{{ value|capitalize }}</option>{% endfor %}
            </select>
            {% if parameters.errors.enrichmentStatus is defined %}<p id="enrichmentStatus-error" class="field-error">{{ parameters.errors.enrichmentStatus }}</p>{% endif %}
        </div>
        <div class="filter-actions">
            <button type="submit">Apply filters</button>
            <a class="clear-filters" href="{{ path('application_list') }}">Clear filters</a>
        </div>
    </form>
    <div class="refresh-controls" hidden>
        <p id="refresh-status" role="status" aria-live="polite" aria-atomic="true"></p>
        <button type="button" id="refresh-button">Refresh results</button>
    </div>
    {% include 'applications/_list_results.html.twig' %}
    <p>Mock analysis scores reflect simulated skill matching, not professional suitability.</p>
{% endblock %}
