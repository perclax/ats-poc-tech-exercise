{% extends 'base.html.twig' %}

{% block title %}Application received{% endblock %}

{% block body %}
    <p class="eyebrow">Application <span class="application-id">{{ applicationId }}</span></p>
    <h1>Application received</h1>
    {% if analysisQueued %}
        <p>Your application was stored successfully. Its Mock analysis is pending.</p>
    {% else %}
        <div class="warning" role="status">
            <p>Your application was stored successfully. Its Mock analysis is pending, but automatic analysis could not be started.</p>
            <p>Your application is saved; you do not need to submit it again.</p>
        </div>
    {% endif %}
    <p><a href="{{ path('application_detail', {id: applicationId}) }}">View application</a></p>
{% endblock %}
