<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Viterbit applications{% endblock %}</title>
    <link rel="stylesheet" href="/styles/application.css">
    {% block scripts %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
    <div class="header-content">
        <a class="brand" href="{{ path('application_list') }}">Viterbit <span>Careers demo</span></a>
        <nav aria-label="Main navigation">
            <a href="{{ path('application_apply') }}"{% if app.request.attributes.get('_route') starts with 'application_appl' or app.request.attributes.get('_route') == 'application_submitted' %} aria-current="page"{% endif %}>Apply</a>
            <a href="{{ path('application_list') }}"{% if app.request.attributes.get('_route') in ['application_list', 'application_detail'] %} aria-current="page"{% endif %}>Applications</a>
        </nav>
    </div>
</header>
<main id="main" class="page" tabindex="-1">
    {% block body %}{% endblock %}
</main>
<footer class="page site-footer">Fictional roles · Mock analysis · Evaluator demo</footer>
</body>
</html>
